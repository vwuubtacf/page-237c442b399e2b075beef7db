em;color:var(--mint-2);text-transform:uppercase;margin-bottom:8px}\nsection .intro{color:var(--muted);max-width:760px;margin:0 0 40px;font-size:15px}\n\n/* CARDS via whitespace */\n.stack{display:flex;flex-direction:column;gap:56px}\n.card{display:grid;grid-template-columns:180px 1fr;gap:32px}\n.card .tag{font-size:13px;color:var(--mint-2);letter-spacing:.1em}\n.card h3{font-size:22px;margin:0 0 10px;color:var(--paper)}\n.card p{margin:0 0 12px;font-size:15px;color:#D8CBB6}\n@media(max-width:720px){.card{grid-template-columns:1fr;gap:12px}}\n\n/* PLANS */\n.plan-list{display:flex;flex-direction:column;gap:40px}\n.plan{background:var(--bg-2);border-left:4px solid var(--line);padding:28px 32px}\n.plan.featured{border-left-color:var(--mint)}\n.plan .head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:12px;margin-bottom:14px}\n.plan .name{font-size:22px;color:var(--mint)}\n.plan .price{font-size:18px;color:var(--paper)}\n.plan .annual{font-size:13px;color:var(--muted);margin-bottom:18px}\n.plan ul{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.plan ul li{font-size:14px;color:#D8CBB6;padding-left:18px;position:relative}\n.plan ul li::before{content:\"\";position:absolute;left:0;top:10px;width:8px;height:1px;background:var(--mint-2)}\n@media(max-width:680px){.plan ul{grid-template-columns:1fr}}\n\n/* FAQ */\n.faq{display:flex;flex-direction:column;gap:0;border-top:1px solid var(--line)}\n.faq details{border-bottom:1px solid var(--line);padding:18px 0}\n.faq summary{cursor:pointer;list-style:none;font-size:16px;color:var(--paper);display:flex;justify-content:space-between;gap:16px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:\"+\";color:var(--mint);font-size:18px}\n.faq details[open] summary::after{content:\"–\"}\n.faq .a{padding-top:12px;color:#C9BAA0;font-size:14px;max-width:760px}\n\n/* CLIENTS */\n.client-block{padding:40px 0}\n.client-block .no-data{color:var(--muted);font-size:14px}\n\nfooter{padding:32px 24px 56px;color:var(--muted);font-size:13px;border-top:1px solid var(--line);margin-top:40px}\nfooter .row{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px}\n</style><header>\n  <div class=\"brand\">白云机场 · BYJC</div>\n  <nav>\n    <a href=\"#features\">功能</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#usage\">使用</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n</header>\n\n<main>\n\n\n<section class=\"hero\" aria-label=\"首屏\">\n  <div class=\"meta\">\n    <b>编号</b> BYJC-0001 · <b>类别</b> 网络加速 · <b>语言</b> 简体中文\n  </div>\n  <h1>白云机场(BYJC)<br>跨境网络加速服务</h1>\n  <p class=\"lede\">“我们提供结构清晰的线路组合与流量方案，不承诺‘极致’或‘全球’，只提供可被说明书描述的服务边界。”</p>\n\n  <div class=\"col-a\">\n    <p>白云机场(BYJC) 是一项面向中文用户的网络加速服务，按月或按年订阅。我们以节点组合、流量配额与设备数量作为基本度量单位，用户可据此选择与其使用强度相匹配的套餐。</p>\n    <p>服务覆盖家庭与小型团队场景，提供流媒体解锁与 IPLC 优化线路。我们不使用“永久”“无限”“全宇宙覆盖”等不可被度量的表述。</p>\n  </div>\n\n  <div class=\"col-b\">\n    <p>本页为服务说明文档性质，内容包含功能边界、套餐价格、使用步骤与常见问题。所有价格以人民币结算，所有流量以 GB 为单位，所有设备限制以同时在线数计算。</p>\n    <p>若你已订阅，请直接参阅“使用说明”与“客户端”章节；若尚未订阅，请先阅读“套餐”与“常见问题”，再决定是否购买。</p>\n  </div>\n</section>\n\n\n<section id=\"features\">\n  <div class=\"label\">01 / 功能边界</div>\n  <h2>我们做什么，不做什么</h2>\n  <p class=\"intro\">以下功能描述遵循说明书体例，仅说明可被验证的能力，不使用主观形容词。</p>\n\n  <div class=\"stack\">\n    <article class=\"card\">\n      <div class=\"tag\">线路 / 节点池</div>\n      <div>\n        <h3>分层节点组合</h3>\n        <p>基础版使用普通线路节点池，旗舰版与团队版提供 IPLC 专线与 VIP 高带宽节点。节点位置会根据线路稳定性调整，不在页面公开节点列表。</p>\n        <p>我们不承诺“全球覆盖”或“99.99% 可用”，线路状态以实际连接为准。</p>\n      </div>\n    </article>\n\n    <article class=\"card\">\n      <div class=\"tag\">流媒体 / 解锁</div>\n      <div>\n        <h3>原生流媒体解锁</h3>\n        <p>基础版支持基础流媒体访问，旗舰版与团队版提供全节点原生解锁。解锁能力受目标平台策略影响，可能随时间变化。</p>\n        <p>若某平台在某时段不可访问，属第三方策略变更，非本服务违约。</p>\n      </div>\n    </article>\n\n    <article class=\"card\">\n      <div class=\"tag\">设备 / 接入</div>\n      <div>\n        <h3>多终端并发</h3>\n        <p>基础版支持 3 台设备同时在线，旗舰版 5 台，团队版 20 台。超出限制时，新设备将无法建立连接，已连接设备不受影响。</p>\n        <p>设备识别基于连接指纹，更换网络不会消耗设备额度。</p>\n      </div>\n    </article>\n\n    <article class=\"card\">\n      <div class=\"tag\">流量 / 计费</div>\n      <div>\n        <h3>月度流量配额</h3>\n        <p>流量按自然月重置，未使用部分不结转。流量用量可在用户面板查看，统计以服务端为准，可能与本地统计存在轻微差异。</p>\n        <p>套餐外流量暂不支持单独购买。</p>\n      </div>\n    </article>\n  </div>\n</section>\n\n\n<section id=\"plans\">\n  <div class=\"label\">02 / 套餐</div>\n  <h2>订阅方案</h2>\n  <p class=\"intro\">三档套餐按流量、设备数与线路等级区分，均为按月或按年付费。年付价格低于 12 个月月付之和。</p>\n\n  <div class=\"plan-list\">\n\n    <article class=\"plan\">\n      <div class=\"head\">\n        <span class=\"name\">基础版</span>\n        <span class=\"price\">¥15 / 月</span>\n      </div>\n      <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n      <ul>\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n    </article>\n\n    <article class=\"plan featured\">\n      <div class=\"head\">\n        <span class=\"name\">旗舰版 <span>推荐</span></span>\n        <span class=\"price\">¥35 / 月</span>\n      </div>\n      <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n      <ul>\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7×24 优先工单支持</li>\n      </ul>\n    </article>\n\n    <article class=\"plan\">\n      <div class=\"head\">\n        <span class=\"name\">团队版</span>\n        <span class=\"price\">¥85 / 月</span>\n      </div>\n      <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n      <ul>\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n    </article>\n\n  </div>\n</section>\n\n\n<section id=\"usage\">\n  <div class=\"label\">03 / 使用说明</div>\n  <h2>如何接入</h2>\n  <p class=\"intro\">订阅后请按以下顺序完成接入，步骤不可跳过。</p>\n\n  <div class=\"stack\">\n    <article class=\"card\">\n      <div class=\"tag\">步骤 01</div>\n      <div>\n        <h3>获取订阅地址</h3>\n        <p>登录用户面板，在“我的订阅”页面复制你的专属订阅地址。该地址与账号绑定，请勿公开分享。</p>\n      </div>\n    </article>\n\n    <article class=\"card\">\n      <div class=\"tag\">步骤 02</div>\n      <div>\n        <h3>安装客户端</h3>\n        <p>根据你的设备平台选择对应客户端，安装完成后打开应用。客户端列表见下方“客户端”章节。</p>\n      </div>\n    </article>\n\n    <article class=\"card\">\n      <div class=\"tag\">步骤 03</div>\n      <div>\n        <h3>导入订阅</h3>\n        <p>在客户端中选择“从订阅地址导入”或“更新订阅”，粘贴步骤 01 中的地址，等待节点列表加载完成。</p>\n      </div>\n    </article>\n\n    <article class=\"card\">\n      <div class=\"tag\">步骤 04</div>\n      <div>\n        <h3>选择节点并连接</h3>\n        <p>从节点列表中选择一个节点，点击连接。连接成功后，设备流量将经由该节点转发。更换节点需先断开当前连接。</p>\n      </div>\n    </article>\n\n    <article class=\"card\">\n      <div class=\"tag\">步骤 05</div>\n      <div>\n        <h3>流量与续费</h3>\n        <p>每月流量用尽后，服务将暂停至下月重置。如需提前恢复，可升级至更高套餐；年付用户在到期前续费可保持连续服务。</p>\n      </div>\n    </article>\n  </div>\n</section>\n\n\n<section id=\"clients\">\n  <div class=\"label\">04 / 客户端</div>\n  <h2>支持平台</h2>\n  <p class=\"intro\">白云机场(BYJC) 使用通用订阅协议，兼容主流第三方客户端。我们不强制要求安装指定应用。</p>\n\n  <div class=\"client-block\">\n    <div class=\"no-data\">\n      目前未提供官方独立客户端下载地址。用户可使用支持订阅协议的第三方客户端接入服务，或在用户面板查看推荐的客户端名称与平台适配信息。\n    </div>\n  </div>\n</section>\n\n\n<section id=\"faq\">\n  <div class=\"label\">05 / 常见问题</div>\n  <h2>问题与边界</h2>\n  <p class=\"intro\">以下问答用于澄清服务边界，不构成额外承诺。</p>\n\n  <div class=\"faq\">\n    <details>\n      <summary>流量用完了怎么办？</summary>\n      <div class=\"a\">流量按自然月重置。当月用尽后，服务暂停至次月 1 日自动恢复。如需当月继续使用，可升级套餐，升级后流量差额不补发，按新套餐额度计算。</div>\n    </details>\n\n    <details>\n      <summary>可以同时用几台设备？</summary>\n      <div class=\"a\">基础版 3 台，旗舰版 5 台，团队版 20 台。设备计数基于同时在线连接数，不基于账号登录数。同一账号在不同设备上分别连接，会占用对应数量的额度。</div>\n    </details>\n\n    <details>\n      <summary>支持哪些客户端？</summary>\n      <div class=\"a\">服务使用通用订阅协议，兼容主流第三方客户端。我们不提供官方独立客户端，也不绑定特定应用。用户可在用户面板查看适配说明。</div>\n    </details>\n\n    <details>\n      <summary>能不能退款？</summary>\n      <div class=\"a\">订阅服务为虚拟商品，一经开通原则上不予退款。如因服务端故障导致连续 72 小时不可用，可联系工单协商延期或补偿。因第三方平台策略变更导致的解锁失效，不视为服务端故障。</div>\n    </details>\n\n    <details>\n      <summary>节点列表为什么不公开？</summary>\n      <div class=\"a\">节点位置会根据线路质量动态调整。公开固定列表会导致节点被滥用或被策略识别，反而降低可用性。用户在客户端中看到的节点名称为逻辑标签，不代表物理位置。</div>\n    </details>\n\n    <details>\n      <summary>团队版可以开发票吗？</summary>\n      <div class=\"a\">团队版支持开具增值税普通电子发票，请在付款后联系专属客户经理提交开票信息。基础版与旗舰版暂不提供开票服务。</div>\n    </details>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"row\">\n    <div>白云机场(BYJC) · 跨境网络加速服务</div>\n    <div>本页内容为服务说明，不构成交易要约，最终以用户面板为准。</div>\n  </div>\n</footer>",
